# Copy to kickpi-neptune.env, review, then source it before running the installer.

WIFI_IF=wlan0
ETH_IF=eth0

LAN_CIDR=192.168.50.1/24
LAN_IP=192.168.50.1
PRINTER_IP=192.168.50.20

# Optional: use the printer Ethernet MAC address for an explicit DHCP host entry.
PRINTER_MAC=
DHCP_LEASE=24h

CAMERA_ENABLED=yes
# Leave empty to auto-detect /dev/v4l/by-id/*-video-index0.
CAMERA_DEVICE=
CAMERA_PORT=8080
CAMERA_RESOLUTION=1280x720
CAMERA_FPS=30

SKIP_APT=no
PRINTER_WAIT_SECONDS=60
